{
  "name": "dewhollow-farm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "晨露農場：原創農場生活網頁遊戲（垂直切片 MVP）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:stress": "DEWHOLLOW_VIEWPORT_CYCLES=100 playwright test tests/e2e/viewport-cycle-stability.spec.ts --grep='100-cycle viewport stability' --workers=1",
    "sim": "SIM_REPORT=1 vitest run tests/sim",
    "budget": "node tools/build/check-dist.mjs",
    "assets:gate1:check": "node tools/art/check_gate1_assets.mjs",
    "assets:gate1:animation:check": "node tools/art/check_gate1_animation.mjs",
    "assets:gate1:map:check": "node tools/art/check_gate1_map.mjs",
    "assets:gate1:crops:check": "node tools/art/check_gate1_crops.mjs",
    "assets:gate1:interactables:check": "node tools/art/check_gate1_interactables.mjs",
    "assets:gate1:pets:check": "node tools/art/check_gate1_pets_pixel32.mjs",
    "assets:gate1:world-v2-scene:check": "node tools/art/check_gate1_world_v2_scene.mjs",
    "licenses": "node tools/licenses/generate.mjs",
    "icons": "node tools/pwa/make-icons.mjs",
    "check": "npm run assets:gate1:check && npm run assets:gate1:animation:check && npm run assets:gate1:map:check && npm run assets:gate1:crops:check && npm run assets:gate1:interactables:check && npm run assets:gate1:pets:check && npm run assets:gate1:world-v2-scene:check && npm run typecheck && npm test && npm run build && npm run budget"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "phaser": "^4.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
